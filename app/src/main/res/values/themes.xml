<resources>
    <style name="Theme.Dipti" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/dipti_blue</item>
        <item name="colorAccent">@color/dipti_green</item>
        <item name="android:statusBarColor">@color/dipti_blue</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.Dipti.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Dipti</item>
    </style>
</resources>
